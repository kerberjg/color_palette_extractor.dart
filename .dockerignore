# Version control
.git
.gitignore
.gitattributes

# Dart / Pub artifacts
.dart_tool/
.packages
.pub-cache/
.pub/
build/
doc/api/

# Package metadata that isn't needed at runtime
pubspec.lock
*.g.dart
coverage/
*.md
LICENSE
CHANGELOG.md

# CI / CDN config
.github/
.travis.yml
.circleci/
codecov.yml

# Editors / IDEs
.idea/
.vscode/
*.iml

# Environment & secrets
.env
.env.*
*.pem
*.key

# OS / misc
.DS_Store
Thumbs.db
*.log
tmp/

# Docker files (avoid sending into build context)
Dockerfile*
.dockerignore
docker-compose*.yml

example/color_palette_ui/